# Copy to .env (never commit real values). All variables are optional in development.

# Database. Leave empty to use the built-in embedded database (stored in ./data, no installation needed).
# For production use PostgreSQL: postgres://user:password@host:5432/mini_empire
DATABASE_URL=
# Tests use a fresh in-memory embedded database by default. A PostgreSQL URL here gets its schema DROPPED!
TEST_DATABASE_URL=

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Session lifetime for bearer tokens (hours)
SESSION_TTL_HOURS=720

# Salt for hashing client IPs (multi-account signals). REQUIRED in production.
IP_HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Telegram Mini App login. Leave empty to disable. Get it from @BotFather.
TELEGRAM_BOT_TOKEN=
# Public HTTPS address of the server; with a bot token, the server registers the bot webhook and menu button.
PUBLIC_URL=

# true when running behind a reverse proxy that sets X-Forwarded-For (nginx, Caddy, cloud LB)
TRUST_PROXY=false

# Only needed when the client is served from a different origin than the API.
CORS_ORIGIN=

# Where the built client lives (served by the API server in production)
# CLIENT_DIST=/app/client/dist

# Start of season 1 (ISO date). Defaults to the first server start.
# FIRST_SEASON_START=2026-11-01T00:00:00Z

# How often the season state machine checks the clock (seconds)
SEASON_TICK_SECONDS=60
